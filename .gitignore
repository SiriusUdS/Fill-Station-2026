build
mx.scratch
!.settings

# CM4 core is unused (CM7-only build). CubeMX may regenerate CM4/ from the dual-core
# .ioc; keep it untracked and unbuilt. Each board's project lives at src/boards/<board>/.
CM4/
src/boards/*/CM4/

# Portable host toolchain (MinGW-w64) for running logic unit tests.
tools/

# GoogleTest is fetched on demand, not committed.
src/app/tests/third_party/

# IDE-generated C/C++ config (clangd/CMake drive include paths instead).
.vscode/c_cpp_properties.json

# CubeMX regenerates per-board toolchain/preset copies at the project root; we build
# via the top-level selector + repo-root toolchain, so these board-root copies are unused.
src/boards/*/gcc-arm-none-eabi.cmake
src/boards/*/starm-clang.cmake
src/boards/*/CMakePresets.json
