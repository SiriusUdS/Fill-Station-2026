{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "fcu-Debug",
            "inherits": "default",
            "cacheVariables": { "BOARD": "fcu", "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "fcu-Release",
            "inherits": "default",
            "cacheVariables": { "BOARD": "fcu", "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "ecu-Debug",
            "inherits": "default",
            "cacheVariables": { "BOARD": "ecu", "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "ecu-Release",
            "inherits": "default",
            "cacheVariables": { "BOARD": "ecu", "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "fcu-Debug",   "configurePreset": "fcu-Debug" },
        { "name": "fcu-Release", "configurePreset": "fcu-Release" },
        { "name": "ecu-Debug",   "configurePreset": "ecu-Debug" },
        { "name": "ecu-Release", "configurePreset": "ecu-Release" }
    ]
}
